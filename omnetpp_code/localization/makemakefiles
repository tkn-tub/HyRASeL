#
# Usage:
#    make -f makemakefiles
# or, for Microsoft Visual C++:
#    nmake -f makemakefiles MMOPT=-n
#

MAKEMAKE=opp_makemake $(MMOPT)

INET_4_5_4_PROJ=../inet-4.5.4

all:
	cd src && $(MAKEMAKE) --make-so -f --deep -KINET_4_5_4_PROJ=../../inet-4.5.4 -DINET_IMPORT -I$$\(INET_4_5_4_PROJ\)/src -L$$\(INET_4_5_4_PROJ\)/src -lINET$$\(D\)
